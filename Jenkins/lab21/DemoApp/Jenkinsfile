pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        DOCKERHUB_USER  = 'rehammm22'
        IMAGE_NAME      = "${DOCKERHUB_USER}/demoapp"
        IMAGE_TAG       = "${BUILD_NUMBER}"
        FULL_IMAGE      = "${IMAGE_NAME}:${IMAGE_TAG}"

        // The application source + Dockerfile are checked out by Jenkins (SCM checkout)
        APP_DIR         = 'Jenkins/lab21/DemoApp'
        DEPLOYMENT_FILE = "${APP_DIR}/deployment.yaml"
    }

    stages {

        // 1) Build the Java application -> target/demo-0.0.1-SNAPSHOT.jar
        stage('1. Build App') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn -B clean package -DskipTests'
                    sh 'ls -lh target/*.jar'
                }
            }
        }

        // 2) Build the Docker image from the Dockerfile next to the application
        stage('2. Build Docker Image') {
            steps {
                dir("${APP_DIR}") {
                    sh 'docker build -t "$FULL_IMAGE" .'
                    sh 'docker images "$IMAGE_NAME"'
                }
            }
        }

        // 3) Scan the image for HIGH/CRITICAL vulnerabilities (report only)
        stage('3. Scan Docker Image') {
            steps {
                sh '''
                    mkdir -p "$WORKSPACE/.trivy-tmp"
                    TMPDIR="$WORKSPACE/.trivy-tmp" trivy image \
                        --skip-version-check \
                        --scanners vuln \
                        --no-progress \
                        --severity HIGH,CRITICAL \
                        --format table "$FULL_IMAGE"
                    rm -rf "$WORKSPACE/.trivy-tmp"
                '''
            }
        }

        // 4) Login to Docker Hub with the Jenkins credential, then push the image
        stage('4. Push to DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId:    'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push "$FULL_IMAGE"
                    '''
                }
            }
        }

        // 5) Remove the image from the local Docker daemon to save disk space
        stage('5. Delete Local Image') {
            steps {
                sh 'docker rmi -f "$FULL_IMAGE" || true'
                sh 'docker images "$IMAGE_NAME" || true'
            }
        }

        // 6) Replace the image tag inside the Kubernetes deployment manifest
        stage('6. Update Deployment File') {
            steps {
                sh '''
                    sed -i "s|image: .*|image: ${FULL_IMAGE}|" "$DEPLOYMENT_FILE"
                    echo "New image line in $DEPLOYMENT_FILE:"
                    grep -n "image:" "$DEPLOYMENT_FILE"
                '''
            }
        }

        // 7) Apply the manifest to the cluster and wait for the rollout to finish
        stage('7. Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl apply -f "$DEPLOYMENT_FILE"
                    kubectl rollout status deployment/demoapp --timeout=180s
                    kubectl get pods -l app=demoapp -o wide
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline finished with status: ${currentBuild.currentResult}"
            sh 'docker logout || true'
        }
        success {
            echo "SUCCESS: ${FULL_IMAGE} was built, scanned, pushed and deployed to Kubernetes."
        }
        failure {
            echo "FAILURE: the pipeline failed. Check the stage marked in red in the build log above."
        }
    }
}
